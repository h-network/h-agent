#!/usr/bin/env bash
set -euo pipefail

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

make_cli() {
    local name=$1
    cat >"$tmp/$name" <<'EOF'
#!/usr/bin/env bash
printf 'HOME=%s\n' "$HOME"
printf 'BASE=%s\n' "${ANTHROPIC_BASE_URL-}"
printf 'OPUS=%s\n' "${ANTHROPIC_DEFAULT_OPUS_MODEL-}"
printf 'HAIKU=%s\n' "${ANTHROPIC_DEFAULT_HAIKU_MODEL-}"
printf 'MCPTOK=%s\n' "${HAGENT_MCP_TOKEN_hb-}"
printf 'ARG=%s\n' "$@"
EOF
    chmod +x "$tmp/$name"
}

for cli in claude agy codex; do make_cli "$cli"; done
export PATH="$tmp:$PATH"

fail() { printf 'not ok - %s\n' "$1" >&2; exit 1; }
assert_has() { grep -Fqx -- "$2" <<<"$1" || fail "missing: $2"; }
assert_has_sub() { grep -Fq -- "$2" <<<"$1" || fail "missing substring: $2"; }

output=$(HOME=/chosen/home "$root/h-agent" codex run)
assert_has "$output" 'HOME=/chosen/home'
assert_has "$output" 'ARG=--dangerously-bypass-approvals-and-sandbox'
assert_has "$output" 'ARG=run'

output=$(AGENT_SKIP_PERMISSIONS=0 "$root/h-agent" agy prompt)
assert_has "$output" 'ARG=prompt'
if grep -Fq -- '--dangerously-skip-permissions' <<<"$output"; then
    fail 'skip flag present when disabled'
fi

output=$(AGENT_PROVIDER_URL=http://localhost:8000/v1/ \
    AGENT_PROVIDER_MODEL=large AGENT_PROVIDER_SMALL_MODEL=small \
    "$root/h-agent" claude 2>/dev/null)
assert_has "$output" 'BASE=http://localhost:8000'
assert_has "$output" 'OPUS=large'
assert_has "$output" 'HAIKU=small'

if AGENT_PROVIDER_URL=http://localhost AGENT_PROVIDER_MODEL=x \
    "$root/h-agent" codex >/dev/null 2>&1; then
    fail 'codex accepted a local provider'
fi

if "$root/h-agent" unknown >/dev/null 2>&1; then
    fail 'unknown CLI was accepted'
fi

# fork: claude, no id -> --continue --fork-session; with id -> --resume <id>.
output=$(HOME="$tmp/forkhome" "$root/h-agent" fork 2>/dev/null)
assert_has "$output" 'ARG=--continue'
assert_has "$output" 'ARG=--fork-session'
output=$(HOME="$tmp/forkhome" "$root/h-agent" fork claude 2>/dev/null)
assert_has "$output" 'ARG=--continue'
output=$(HOME="$tmp/forkhome" "$root/h-agent" fork 1234-abcd 2>/dev/null)
assert_has "$output" 'ARG=--resume'
assert_has "$output" 'ARG=1234-abcd'
assert_has "$output" 'ARG=--fork-session'
if grep -Fqx 'ARG=--continue' <<<"$output"; then
    fail 'fork <id> should resume, not continue'
fi
# codex fork maps to the `fork` subcommand: --last by default, else the id.
output=$(HOME="$tmp/forkhome" "$root/h-agent" fork codex 2>/dev/null)
assert_has "$output" 'ARG=fork'
assert_has "$output" 'ARG=--last'
output=$(HOME="$tmp/forkhome" "$root/h-agent" fork codex sess-9 2>/dev/null)
assert_has "$output" 'ARG=fork'
assert_has "$output" 'ARG=sess-9'
if grep -Fqx 'ARG=--last' <<<"$output"; then
    fail 'codex fork <id> should not also pass --last'
fi
# agy fork unsupported -> error, not launch
if "$root/h-agent" fork agy >/dev/null 2>&1; then
    fail 'agy fork should be rejected'
fi

# Reasoning effort: claude gets --effort high by default; AGENT_EFFORT overrides;
# an empty value omits the flag entirely.
output=$(HOME="$tmp/effhome" "$root/h-agent" claude 2>/dev/null)
assert_has "$output" 'ARG=--effort'
assert_has "$output" 'ARG=high'
output=$(AGENT_EFFORT=medium HOME="$tmp/effhome" "$root/h-agent" claude 2>/dev/null)
assert_has "$output" 'ARG=medium'
if grep -Fqx 'ARG=high' <<<"$output"; then
    fail 'AGENT_EFFORT override did not replace the default'
fi
output=$(AGENT_EFFORT='' HOME="$tmp/effhome" "$root/h-agent" claude 2>/dev/null)
if grep -Fqx 'ARG=--effort' <<<"$output"; then
    fail 'empty AGENT_EFFORT still passed --effort'
fi
# effort applies to agy (--effort) and codex (-c model_reasoning_effort) too.
output=$(HOME="$tmp/effhome" "$root/h-agent" agy 2>/dev/null)
assert_has "$output" 'ARG=--effort'
assert_has "$output" 'ARG=high'
output=$(HOME="$tmp/effhome" "$root/h-agent" codex 2>/dev/null)
assert_has_sub "$output" 'model_reasoning_effort="high"'
output=$(AGENT_EFFORT=xhigh HOME="$tmp/effhome" "$root/h-agent" codex 2>/dev/null)
assert_has_sub "$output" 'model_reasoning_effort="xhigh"'
output=$(AGENT_EFFORT='' HOME="$tmp/effhome" "$root/h-agent" codex 2>/dev/null)
if grep -Fq 'model_reasoning_effort' <<<"$output"; then
    fail 'empty AGENT_EFFORT still set codex effort'
fi

# Capture is on by default for claude: --settings registers exactly the three
# events we keep (session boundaries + Bash commands), wired to h-agent-capture,
# with PreToolUse scoped to Bash. No other events are registered.
output=$(HOME="$tmp/caphome" "$root/h-agent" claude 2>/dev/null)
for event in SessionStart SessionEnd PreToolUse; do
    assert_has_sub "$output" "\"$event\""
done
for event in UserPromptSubmit PostToolUse Stop PreCompact PostCompact; do
    if grep -Fq "\"$event\"" <<<"$output"; then
        fail "capture settings should not register $event"
    fi
done
assert_has_sub "$output" '"matcher":"Bash"'
assert_has_sub "$output" '"type":"command"'
assert_has_sub "$output" 'h-agent-capture\" claude'
# A disabled or non-claude run injects no hook settings.
output=$(AGENT_CAPTURE=0 HOME="$tmp/caphome" "$root/h-agent" claude 2>/dev/null)
if grep -Fq '"hooks"' <<<"$output"; then
    fail 'capture settings present when AGENT_CAPTURE=0'
fi
# Idle compaction is off by default, on with AGENT_IDLE_COMPACTION=1, and
# shares the single --settings argument with the capture hooks.
output=$(HOME="$tmp/caphome" "$root/h-agent" claude 2>/dev/null)
assert_has_sub "$output" '"idleCompaction":false}'
test "$(grep -Fc 'ARG=--settings' <<<"$output")" -eq 1 || fail 'claude got more than one --settings'
output=$(AGENT_IDLE_COMPACTION=1 HOME="$tmp/caphome" "$root/h-agent" claude 2>/dev/null)
assert_has_sub "$output" '"idleCompaction":true}'
assert_has_sub "$output" '"hooks"'
output=$(AGENT_CAPTURE=0 HOME="$tmp/caphome" "$root/h-agent" claude 2>/dev/null)
assert_has_sub "$output" '{"idleCompaction":false}'
# codex gets the same three events, but as ONE -c hooks table, plus the
# trust-bypass flag (trust cannot be set through -c).
output=$(HOME="$tmp/caphome" "$root/h-agent" codex 2>/dev/null)
assert_has_sub "$output" '--dangerously-bypass-hook-trust'
assert_has_sub "$output" 'hooks={'
assert_has_sub "$output" 'SessionStart='
assert_has_sub "$output" 'SessionEnd='
assert_has_sub "$output" 'PreToolUse='
assert_has_sub "$output" 'matcher="^Bash'
assert_has_sub "$output" 'h-agent-capture codex'
for event in UserPromptSubmit PostToolUse Stop; do
    if grep -Fq "$event" <<<"$output"; then
        fail "codex capture should not register $event"
    fi
done
# the three hook events are combined into a single -c value (not three)
test "$(grep -Fc 'ARG=hooks={' <<<"$output")" -eq 1 || fail 'codex capture hooks should be one combined -c'
# disabling capture removes the overrides and the flag
output=$(AGENT_CAPTURE=0 HOME="$tmp/caphome" "$root/h-agent" codex 2>/dev/null)
if grep -Fq 'hooks=' <<<"$output"; then
    fail 'codex capture present when AGENT_CAPTURE=0'
fi
if grep -Fq -- '--dangerously-bypass-hook-trust' <<<"$output"; then
    fail 'codex trust-bypass present when AGENT_CAPTURE=0'
fi

# --log prints the capture log, optionally filtered to one agent.
caplog="$tmp/commands.jsonl"
cat >"$caplog" <<'EOF'
{"ts":"2026-10-18T04:00:00Z","agent":"claude","name":"researcher","session_id":"aaaa1111-2222","event":"PreToolUse","tool_name":"Bash","command":"ls -la"}
{"ts":"2026-10-18T04:00:01Z","agent":"claude","name":"researcher","session_id":"aaaa1111-2222","event":"SessionStart"}
{"ts":"2026-10-18T04:00:02Z","agent":"codex","name":"coder","session_id":"bbbb3333-4444","event":"PreToolUse","tool_name":"Bash","command":"git status"}
EOF
output=$(AGENT_CAPTURE_FILE="$caplog" "$root/h-agent" --log)
assert_has_sub "$output" 'ls -la'
assert_has_sub "$output" 'git status'
# session id is surfaced (short form) so sessions are distinguishable
assert_has_sub "$output" '#aaaa1111'
assert_has_sub "$output" '#bbbb3333'
# filtering by a session id (prefix) narrows to that session only
output=$(AGENT_CAPTURE_FILE="$caplog" "$root/h-agent" --log aaaa1111)
assert_has_sub "$output" 'ls -la'
if grep -Fq 'git status' <<<"$output"; then
    fail '--log <session> leaked another session'
fi
# filtered to claude: its command shows, codex's does not
output=$(AGENT_CAPTURE_FILE="$caplog" "$root/h-agent" --log claude)
assert_has_sub "$output" 'ls -la'
if grep -Fq 'git status' <<<"$output"; then
    fail '--log claude leaked codex entries'
fi
# the bare "log" verb works too
output=$(AGENT_CAPTURE_FILE="$caplog" "$root/h-agent" log codex)
assert_has_sub "$output" 'git status'
if grep -Fq 'ls -la' <<<"$output"; then
    fail '--log codex leaked claude entries'
fi
# filtering works without perl (substring match on the agent field)
output=$(H_AGENT_PERL=perl-not-installed AGENT_CAPTURE_FILE="$caplog" "$root/h-agent" --log codex)
assert_has_sub "$output" 'git status'
if grep -Fq 'ls -la' <<<"$output"; then
    fail '--log codex (no perl) leaked claude entries'
fi
# filtering by AGENT_NAME instance label works (perl and no-perl paths)
output=$(AGENT_CAPTURE_FILE="$caplog" "$root/h-agent" --log researcher)
assert_has_sub "$output" 'ls -la'
if grep -Fq 'git status' <<<"$output"; then
    fail '--log researcher leaked other instances'
fi
output=$(H_AGENT_PERL=perl-not-installed AGENT_CAPTURE_FILE="$caplog" "$root/h-agent" --log coder)
assert_has_sub "$output" 'git status'
if grep -Fq 'ls -la' <<<"$output"; then
    fail '--log coder (no perl) leaked other instances'
fi
# a missing log is an error, not a crash
if AGENT_CAPTURE_FILE="$tmp/absent.jsonl" "$root/h-agent" --log >/dev/null 2>&1; then
    fail '--log succeeded with no log file'
fi

# <cli> mcp ...: forwarded to the CLI's own mcp command, no launch flags.
for cli in claude codex agy; do
    output=$("$root/h-agent" "$cli" mcp add srv -- cmd arg)
    assert_has "$output" 'ARG=mcp'
    assert_has "$output" 'ARG=add'
    assert_has "$output" 'ARG=cmd'
    if grep -Eq -- '--dangerously|--tools|--settings|--effort' <<<"$output"; then
        fail "mcp on $cli got launch flags"
    fi
done

# MCP registry: add/list/remove, then injection into each CLI at launch.
export AGENT_MCP_FILE="$tmp/mcp.json"
printf 's3cret\n' >"$tmp/tok"
"$root/h-agent" mcp add hb --url https://mcp.example/mcp --token-file "$tmp/tok" >/dev/null
"$root/h-agent" mcp add fs --env K=a=b -- npx -y srv >/dev/null
output=$("$root/h-agent" mcp list)
assert_has_sub "$output" 'hb	http https://mcp.example/mcp'
assert_has_sub "$output" 'fs	stdio npx -y srv'
[ "$(stat -c %a "$AGENT_MCP_FILE")" = 600 ] || fail 'registry not mode 600'
if grep -Fq s3cret "$AGENT_MCP_FILE"; then fail 'token stored in registry'; fi
if "$root/h-agent" mcp add 'bad name' --url x >/dev/null 2>&1; then fail 'bad name accepted'; fi
if "$root/h-agent" mcp add x --url u -- cmd >/dev/null 2>&1; then fail 'url and cmd both accepted'; fi

output=$("$root/h-agent" claude)
if grep -F 'ARG=' <<<"$output" | grep -Fq s3cret; then fail 'token leaked into claude argv'; fi
cfg=$(grep -F 'ARG={"mcpServers"' <<<"$output" | sed 's/^ARG=//')
jq -e '.mcpServers.hb.type == "http" and
       .mcpServers.hb.headers.Authorization == "Bearer ${HAGENT_MCP_TOKEN_hb}" and
       .mcpServers.fs.command == "npx" and .mcpServers.fs.env.K == "a=b"' <<<"$cfg" >/dev/null \
    || fail 'claude mcp config wrong'
assert_has "$output" 'MCPTOK=s3cret'

output=$("$root/h-agent" codex)
if grep -F 'ARG=' <<<"$output" | grep -Fq s3cret; then fail 'token leaked into codex argv'; fi
assert_has_sub "$output" 'ARG=mcp_servers.hb={url="https://mcp.example/mcp",bearer_token_env_var="HAGENT_MCP_TOKEN_hb"}'
assert_has_sub "$output" 'ARG=mcp_servers.fs={command="npx",args=["-y","srv"],env={"K"="a=b"}}'

output=$(AGENT_MCP=0 "$root/h-agent" claude)
if grep -Fq mcpServers <<<"$output"; then fail 'AGENT_MCP=0 still injected'; fi

"$root/h-agent" mcp remove hb >/dev/null
if "$root/h-agent" mcp list | grep -Fq hb; then fail 'remove did not remove'; fi
unset AGENT_MCP_FILE

# --help shows the banner.
assert_has_sub "$("$root/h-agent" --help 2>&1)" 'h-network/h-agent'

printf 'ok - h-agent behavior\n'
