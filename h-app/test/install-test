#!/usr/bin/env bash
set -euo pipefail

root=$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
mkdir -p "$tmp/bin"
export TEST_LOG=$tmp/invocations

cat >"$tmp/bin/curl" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
output=''
url=''
while [ "$#" -gt 0 ]; do
    case "$1" in
        -o) output=$2; shift 2 ;;
        -*) shift ;;
        *) url=$1; shift ;;
    esac
done
case "$url" in
    https://example.invalid/h-agent)
        body='echo installed-test-agent' ;;
    https://example.invalid/seedProfile)
        body='echo installed-test-seedProfile' ;;
    https://example.invalid/setupConfigDir)
        body='echo installed-test-setupConfigDir' ;;
    https://example.invalid/h-agent-profile-lib.sh)
        body='echo installed-test-profile-lib' ;;
    https://claude.ai/install.sh)
        body='printf "claude %s\\n" "$*" >>"$TEST_LOG"; mkdir -p "$HOME/.local/bin"; printf "#!/usr/bin/env bash\\necho 2.1.251 \\(Claude Code\\)\\n" >"$HOME/.local/bin/claude"; chmod +x "$HOME/.local/bin/claude"' ;;
    https://chatgpt.com/codex/install.sh)
        if [ "${TEST_CODEX_INSTALLER_FAIL:-0}" = 1 ]; then
            echo 'curl: (22) The requested URL returned error: 404' >&2
            exit 22
        fi
        body='printf "codex %s noninteractive=%s\\n" "$*" "$CODEX_NON_INTERACTIVE" >>"$TEST_LOG"; mkdir -p "$CODEX_INSTALL_DIR"; printf "#!/usr/bin/env bash\\necho codex-cli 0.149.0\\n" >"$CODEX_INSTALL_DIR/codex"; chmod +x "$CODEX_INSTALL_DIR/codex"' ;;
    https://antigravity.google/cli/install.sh)
        body='printf "agy %s version=%s\\n" "$*" "${TEST_AGY_INSTALLER_VERSION:-9.8.7}" >>"$TEST_LOG"; test "$1" = --dir; mkdir -p "$2"; printf "#!/usr/bin/env bash\\necho %s\\n" "${TEST_AGY_INSTALLER_VERSION:-9.8.7}" >"$2/agy"; chmod +x "$2/agy"' ;;
    *) echo "unexpected URL: $url" >&2; exit 1 ;;
esac
printf '#!/usr/bin/env bash\n%s\n' "$body" >"$output"
EOF
chmod +x "$tmp/bin/curl"

output=$(PATH="$tmp/bin:/usr/bin:/bin" HOME="$tmp/home" SHELL=/bin/zsh \
    H_AGENT_INSTALL_URL=https://example.invalid/h-agent "$root/install.sh")
test -x "$tmp/home/.local/bin/h-agent"
test "$("$tmp/home/.local/bin/h-agent")" = installed-test-agent
test -x "$tmp/home/.local/bin/seedProfile"
test "$("$tmp/home/.local/bin/seedProfile")" = installed-test-seedProfile
test -x "$tmp/home/.local/bin/setupConfigDir"
test "$("$tmp/home/.local/bin/setupConfigDir")" = installed-test-setupConfigDir
test -x "$tmp/home/.local/bin/h-agent-profile-lib.sh"
test "$("$tmp/home/.local/bin/h-agent-profile-lib.sh")" = installed-test-profile-lib
# These variables must remain literal in the printed command.
# shellcheck disable=SC2016
grep -Fqx 'echo '\''export PATH="$HOME/.local/bin:$PATH"'\'' >> "$HOME/.zshrc" && source "$HOME/.zshrc"' <<<"$output"
grep -Fqx 'claude 2.1.251' "$TEST_LOG"
grep -Fqx 'codex --release 0.149.0 noninteractive=1' "$TEST_LOG"
grep -Fqx "agy --dir $tmp/home/.local/bin version=9.8.7" "$TEST_LOG"
jq -e --arg cwd "$root" '
    .hasCompletedOnboarding == true and
    .projects[$cwd].hasTrustDialogAccepted == true and
    .projects[$cwd].hasCompletedProjectOnboarding == true
' "$tmp/home/.claude.json" >/dev/null
jq -e '
    .skipDangerousModePermissionPrompt == true and
    .env.DISABLE_TELEMETRY == "1" and
    .permissions.deny == ["mcp__*"]
' "$tmp/home/.claude/settings.json" >/dev/null
grep -Fqx 'check_for_update_on_startup = false' "$tmp/home/.codex/config.toml"
grep -Fqx 'approval_policy = "never"' "$tmp/home/.codex/config.toml"
grep -Fqx 'sandbox_mode = "danger-full-access"' "$tmp/home/.codex/config.toml"

mkdir -p "$tmp/existing-home/.claude" "$tmp/existing-home/.codex"
cat >"$tmp/existing-home/.claude.json" <<'EOF'
{"hasCompletedOnboarding":false,"custom":"keep","projects":{"/custom":{"keep":true}}}
EOF
cat >"$tmp/existing-home/.claude/settings.json" <<'EOF'
{"skipDangerousModePermissionPrompt":false,"custom":"keep","env":{"DISABLE_TELEMETRY":"0"}}
EOF
cat >"$tmp/existing-home/.codex/config.toml" <<'EOF'
approval_policy = "on-request"

[model_providers.custom]
sandbox_mode = "read-only"
EOF
PATH="$tmp/bin:/usr/bin:/bin" HOME="$tmp/existing-home" H_AGENT_INSTALL_CLIS=0 \
    H_AGENT_INSTALL_URL=https://example.invalid/h-agent "$root/install.sh" >/dev/null
jq -e --arg cwd "$root" '
    .hasCompletedOnboarding == false and .custom == "keep" and
    .projects["/custom"].keep == true and
    .projects[$cwd].hasTrustDialogAccepted == true
' "$tmp/existing-home/.claude.json" >/dev/null
jq -e '
    .skipDangerousModePermissionPrompt == false and .custom == "keep" and
    .env.DISABLE_TELEMETRY == "0" and
    .env.DISABLE_ERROR_REPORTING == "1"
' "$tmp/existing-home/.claude/settings.json" >/dev/null
test "$(grep -Fc 'approval_policy = "on-request"' "$tmp/existing-home/.codex/config.toml")" -eq 1
grep -Fqx 'check_for_update_on_startup = false' "$tmp/existing-home/.codex/config.toml"
grep -Fqx 'sandbox_mode = "danger-full-access"' "$tmp/existing-home/.codex/config.toml"
grep -Fqx 'sandbox_mode = "read-only"' "$tmp/existing-home/.codex/config.toml"

before=$(wc -l <"$TEST_LOG")
PATH="$tmp/bin:/usr/bin:/bin" HOME="$tmp/home" \
    H_AGENT_INSTALL_URL=https://example.invalid/h-agent "$root/install.sh" >/dev/null
test "$(wc -l <"$TEST_LOG")" -eq "$((before + 1))"
grep -Fqx "agy --dir $tmp/home/.local/bin version=9.8.7" "$TEST_LOG"
before=$(wc -l <"$TEST_LOG")

fish_output=$(PATH="$tmp/bin:/usr/bin:/bin" HOME="$tmp/fish-home" SHELL=/usr/bin/fish \
    H_AGENT_INSTALL_CLIS=0 H_AGENT_INSTALL_URL=https://example.invalid/h-agent "$root/install.sh")
# shellcheck disable=SC2016
grep -Fqx 'echo '\''fish_add_path "$HOME/.local/bin"'\'' >> "$HOME/.config/fish/config.fish" && source "$HOME/.config/fish/config.fish"' <<<"$fish_output"

PREFIX=/opt/h-agent DESTDIR="$tmp/stage" PATH="$tmp/bin:/usr/bin:/bin" HOME="$tmp/stage-home" \
    H_AGENT_INSTALL_URL=https://example.invalid/h-agent "$root/install.sh" >/dev/null
test -x "$tmp/stage/opt/h-agent/bin/h-agent"
test -x "$tmp/stage/opt/h-agent/bin/seedProfile"
test -x "$tmp/stage/opt/h-agent/bin/setupConfigDir"
test -x "$tmp/stage/opt/h-agent/bin/h-agent-profile-lib.sh"
test "$(wc -l <"$TEST_LOG")" -eq "$before"
test ! -e "$tmp/stage-home/.claude.json"
test ! -e "$tmp/stage-home/.codex/config.toml"

if PREFIX=relative PATH="$tmp/bin:/usr/bin:/bin" "$root/install.sh" >/dev/null 2>&1; then
    echo 'not ok - relative PREFIX was accepted' >&2
    exit 1
fi

# A single CLI installer failing (e.g. a 404) must not abort the rest of the
# install: the other CLIs, h-agent's own files, and config seeding must all
# still complete, with a clear message and a nonzero final exit code.
codex_fail_home=$tmp/codex-fail-home
if fail_output=$(TEST_CODEX_INSTALLER_FAIL=1 PATH="$tmp/bin:/usr/bin:/bin" HOME="$codex_fail_home" \
    H_AGENT_INSTALL_URL=https://example.invalid/h-agent "$root/install.sh" 2>&1); then
    echo 'not ok - install.sh exited 0 despite a failed CLI install' >&2
    exit 1
fi
test -x "$codex_fail_home/.local/bin/h-agent"
test -x "$codex_fail_home/.local/bin/seedProfile"
test -x "$codex_fail_home/.local/bin/setupConfigDir"
test -x "$codex_fail_home/.local/bin/h-agent-profile-lib.sh"
test -x "$codex_fail_home/.local/bin/claude"
test -x "$codex_fail_home/.local/bin/agy"
test ! -e "$codex_fail_home/.local/bin/codex"
test -s "$codex_fail_home/.claude.json"
test -s "$codex_fail_home/.codex/config.toml"
grep -Fq 'error: could not download the Codex CLI installer (https://chatgpt.com/codex/install.sh) — skipping codex, continuing' <<<"$fail_output"
grep -Fq 'CLI install summary:' <<<"$fail_output"
grep -Fqx '  ok:     claude agy' <<<"$fail_output"
grep -Fqx '  failed: codex' <<<"$fail_output"

echo 'ok - installer behavior'
