set -uo pipefail

usage() {
    cat <<'EOF'
  ██╗  ██╗      █████╗  ██████╗ ███████╗███╗   ██╗████████╗
  ██║  ██║     ██╔══██╗██╔════╝ ██╔════╝████╗  ██║╚══██╔══╝
  ███████║     ███████║██║  ███╗█████╗  ██╔██╗ ██║   ██║
  ██╔══██║     ██╔══██║██║   ██║██╔══╝  ██║╚██╗██║   ██║
  ██║  ██║     ██║  ██║╚██████╔╝███████╗██║ ╚████║   ██║
  ╚═╝  ╚═╝     ╚═╝  ╚═╝ ╚═════╝ ╚══════╝╚═╝  ╚═══╝   ╚═╝

  h-network/h-agent // unattended launcher for claude · codex · agy

usage: h-agent [claude|agy|codex] [args...]
       h-agent fork [claude|codex] [session-id]
       h-agent probeProvider <url> [model-id]
       h-agent --log [agent-name]

  claude   --dangerously-skip-permissions, tools limited to
           Bash/Read/Write/Edit/Glob/Grep
  agy      --dangerously-skip-permissions
  codex    --dangerously-bypass-approvals-and-sandbox
  fork     fork a session into a new one, leaving the original untouched;
           with a session id forks that one, otherwise the most recent
  probeProvider
           verify that an endpoint serves Claude's Anthropic protocol
  --log    print the capture log (AGENT_CAPTURE_FILE); optionally filtered
           to one CLI (claude/codex), AGENT_NAME label, or session id

With no CLI named, starts $AGENT_CLI (default: claude).
Any further arguments are passed straight to the chosen CLI.

Environment:
  AGENT_CLI               default CLI when none is named (default: claude)
  AGENT_SKIP_PERMISSIONS  1 (default) skips approval prompts; 0 keeps them
  AGENT_CLAUDE_TOOLS      claude's tool list (default:
                          "Bash Read Write Edit Glob Grep"; empty = unrestricted)
  AGENT_EFFORT            claude reasoning effort (default: high; empty = model
                          default). One of low, medium, high, xhigh, max
  AGENT_CAPTURE           1 (default) logs agent hook events; 0 disables
                          (claude and codex)
  AGENT_CAPTURE_FILE      capture log path
                          (default: ~/.local/state/h-agent/commands.jsonl)
  AGENT_NAME              instance label recorded as "name" in each log entry
                          (for distinguishing agents spun up by a framework)

Local inference endpoint (claude only — codex and agy refuse):
  AGENT_PROVIDER_URL          endpoint base, e.g. http://10.0.0.5:8000
                              a trailing /v1 is stripped here
  AGENT_PROVIDER_MODEL        model id, exactly as the endpoint serves it
  AGENT_PROVIDER_SMALL_MODEL  optional, defaults to AGENT_PROVIDER_MODEL
  AGENT_PROVIDER_TOKEN        optional, a placeholder is sent if unset

h-agent inherits the invoking user's environment, including HOME. Install it
under any account; no runtime username or home directory is built in.
EOF
}

json_escape() {
    # Minimal JSON string escaping for values we embed (paths, commands).
    local s=$1
    s=${s//\\/\\\\}
    s=${s//\"/\\\"}
    printf '%s' "$s"
}

build_capture_settings() {
    # Inline Claude settings that register the capture hook. Built with plain
    # shell (no jq at runtime); merged by Claude into the user's own settings
    # via --settings, writing no files. We log session boundaries and shell
    # commands only: SessionStart/SessionEnd plus PreToolUse scoped to Bash.
    local capture=$1 event hooks="" jcmd timeout=5 matcher
    # The hook's "command" is a shell command line; quote the path for spaces.
    jcmd=$(json_escape "\"$capture\" claude")
    for event in SessionStart SessionEnd PreToolUse; do
        case "$event" in
            PreToolUse) matcher="Bash" ;;   # shell commands only, not every tool
            *) matcher="*" ;;
        esac
        [ -n "$hooks" ] && hooks+=","
        hooks+="\"$event\":[{\"matcher\":\"$matcher\",\"hooks\":[{\"type\":\"command\",\"command\":\"$jcmd\",\"timeout\":$timeout}]}]"
    done
    printf '{"hooks":{%s}}' "$hooks"
}

show_log() {
    # Print the capture log, optionally filtered to one agent name. Read-only;
    # formats with perl when available, otherwise prints raw JSON Lines (still
    # filterable by a substring match on the agent field).
    case "${1:-}" in
        -h|--help|help) echo "usage: h-agent --log [agent-name]"; return 0 ;;
    esac
    if [ "$#" -gt 1 ]; then
        echo "usage: h-agent --log [agent-name]" >&2
        return 2
    fi
    local agent=${1:-} log=${AGENT_CAPTURE_FILE:-$HOME/.local/state/h-agent/commands.jsonl}
    if [ ! -e "$log" ]; then
        echo "no capture log at $log" >&2
        return 1
    fi
    local perl_bin=${H_AGENT_PERL:-perl}
    if command -v "$perl_bin" >/dev/null 2>&1; then
        local perl_src
        perl_src=$(cat <<'PERL'
use strict; use warnings;
use JSON::PP;
my $want = defined $ARGV[0] ? $ARGV[0] : '';
while (my $l = <STDIN>) {
    my $d = eval { decode_json($l) };
    next unless ref $d eq 'HASH';
    my $sid = (defined $d->{session_id} && !ref $d->{session_id}) ? $d->{session_id} : '';
    # A filter matches the CLI (agent), the instance name, or a session id
    # (whole, or a leading prefix like the short #id shown below).
    if (length $want) {
        next unless ($d->{agent} // '') eq $want
                 || ($d->{name} // '') eq $want
                 || $sid eq $want
                 || (length $sid && index($sid, $want) == 0);
    }
    my $tag = $d->{agent} // '?';
    $tag .= ':' . $d->{name} if defined $d->{name} && length $d->{name} && !ref $d->{name};
    my @p = ($d->{ts} // '-', "[$tag]");
    push @p, '#' . substr($sid, 0, 8) if length $sid;
    push @p, $d->{event} // '-';
    push @p, $d->{tool_name} if defined $d->{tool_name} && !ref $d->{tool_name};
    my $line = join(' ', @p);
    $line .= ': ' . $d->{command} if defined $d->{command} && !ref $d->{command};
    print $line, "\n";
}
PERL
)
        "$perl_bin" -e "$perl_src" -- "$agent" <"$log"
    elif [ -n "$agent" ]; then
        # No perl: substring-match the CLI, the instance name, or a session id.
        grep -F -e "\"agent\":\"$agent\"" -e "\"name\":\"$agent\"" \
            -e "\"session_id\":\"$agent\"" "$log" || true
    else
        cat "$log"
    fi
}

probe_provider_usage() {
    cat <<'EOF'
usage: h-agent probeProvider <url> [model-id]

Discover models from /v1/models or /api/tags, then verify that the endpoint
serves the Anthropic /v1/messages protocol. Requires curl and jq.

Environment:
  PROBE_TIMEOUT         message probe timeout in seconds (default: 90)
  AGENT_PROVIDER_TOKEN  optional endpoint token
EOF
}

probe_provider() {
    case "${1:-}" in
        -h|--help|help) probe_provider_usage; return 0 ;;
        "") probe_provider_usage >&2; return 2 ;;
    esac
    if [ "$#" -gt 2 ]; then
        probe_provider_usage >&2
        return 2
    fi
    for dependency in curl jq; do
        if ! command -v "$dependency" >/dev/null 2>&1; then
            echo "error: probeProvider requires $dependency" >&2
            return 1
        fi
    done

    local url=$1 requested_model=${2:-} timeout=${PROBE_TIMEOUT:-90}
    local token=${AGENT_PROVIDER_TOKEN:-local-endpoint-no-token}
    local list_timeout=10
    local models='' route='' response http_status curl_status payload probe_model
    local tmpdir
    url=${url%/}
    url=${url%/v1}
    url=${url%/}

    response=$(curl -fsS --max-time "$list_timeout" "$url/v1/models" 2>/dev/null || true)
    if [ -n "$response" ]; then
        models=$(printf '%s' "$response" | jq -r '.data[]?.id | select(type == "string" and length > 0)' 2>/dev/null || true)
    fi
    if [ -n "$models" ]; then
        route=/v1/models
    else
        response=$(curl -fsS --max-time "$list_timeout" "$url/api/tags" 2>/dev/null || true)
        if [ -n "$response" ]; then
            models=$(printf '%s' "$response" | jq -r '.models[]?.name | select(type == "string" and length > 0)' 2>/dev/null || true)
        fi
        [ -n "$models" ] && route=/api/tags
    fi
    if [ -z "$models" ]; then
        echo "NOT USABLE — could not list models from $url/v1/models or $url/api/tags" >&2
        return 1
    fi

    printf 'serves (from %s):\n' "$route"
    printf '%s\n' "$models" | sed 's/^/  /'
    if [ -n "$requested_model" ]; then
        if ! grep -Fqx -- "$requested_model" <<<"$models"; then
            echo "error: '$requested_model' is not served by this endpoint" >&2
            return 1
        fi
        probe_model=$requested_model
    else
        probe_model=$(head -n 1 <<<"$models")
    fi

    payload=$(jq -nc --arg model "$probe_model" \
        '{model: $model, max_tokens: 1, messages: [{role: "user", content: "hi"}]}') || return 1
    tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/h-agent-probe.XXXXXXXX") || return 1
    response=$tmpdir/response
    trap 'rm -rf "$tmpdir"' RETURN
    if http_status=$(curl -sS --max-time "$timeout" -o "$response" -w '%{http_code}' \
        -X POST "$url/v1/messages" \
        -H 'content-type: application/json' \
        -H 'anthropic-version: 2023-06-01' \
        -H "x-api-key: $token" \
        --data "$payload"); then
        curl_status=0
    else
        curl_status=$?
    fi

    if [ "$curl_status" -eq 28 ]; then
        echo "NO ANSWER within ${timeout}s — the model may still be loading (cold start)" >&2
        return 1
    fi
    if [ "$curl_status" -ne 0 ]; then
        echo "NOT USABLE — request to $url/v1/messages failed (curl exit $curl_status)" >&2
        return 1
    fi
    if [ "$http_status" = 200 ] && jq -e '.type == "message"' "$response" >/dev/null 2>&1; then
        echo "USABLE by claude (model: $probe_model)"
        printf 'export AGENT_PROVIDER_URL=%q\n' "$url"
        printf 'export AGENT_PROVIDER_MODEL=%q\n' "$probe_model"
        [ -n "${AGENT_PROVIDER_TOKEN:-}" ] && printf 'export AGENT_PROVIDER_TOKEN=%q\n' "$AGENT_PROVIDER_TOKEN"
        return 0
    fi
    if [ "$http_status" = 404 ]; then
        echo "NOT USABLE — /v1/messages returned 404 for a model this endpoint serves" >&2
        return 1
    fi
    echo "NOT USABLE — HTTP $http_status, and the reply was not an Anthropic message" >&2
    sed -n '1,10{s/^/  /;p;}' "$response" >&2
    return 1
}

if [ "${1:-}" = probeProvider ] || [ "${1:-}" = probe-provider ]; then
    shift
    probe_provider "$@"
    exit $?
fi

if [ "${1:-}" = --log ] || [ "${1:-}" = log ]; then
    shift
    show_log "$@"
    exit $?
fi

cli="${AGENT_CLI:-claude}"
if [ "${1:-}" = fork ]; then
    # Universal "fork a session" command. Normalizes each CLI's own mechanism,
    # then falls through to a normal launch (capture/skip/effort still apply).
    shift
    case "${1:-}" in
        claude|codex|agy) cli="$1"; shift ;;
    esac
    case "$cli" in
        claude)
            # A bare positional is a session id; anything starting with '-'
            # (or nothing) means fork the most recent session.
            if [ "$#" -gt 0 ] && [ "${1#-}" = "$1" ]; then
                fork_sid="$1"; shift
                set -- --resume "$fork_sid" --fork-session "$@"
            else
                set -- --continue --fork-session "$@"
            fi
            ;;
        codex)
            # codex fork is a subcommand, not a flag. Global flags (capture,
            # bypass) are prepended by the normal launch path below. Unverified
            # against a live codex -- confirm the hook fires on a forked session.
            if [ "$#" -gt 0 ] && [ "${1#-}" = "$1" ]; then
                fork_sid="$1"; shift
                set -- fork "$fork_sid" "$@"
            else
                set -- fork --last "$@"
            fi
            ;;
        *)
            echo "error: '$cli' does not support fork" >&2
            exit 2
            ;;
    esac
else
    case "${1:-}" in
        claude|agy|codex) cli="$1"; shift ;;
        -h|--help|help) usage; exit 0 ;;
        "") ;;
        -*) ;;
        *)
            echo "error: unknown agent CLI '$1' (expected claude, agy or codex)" >&2
            echo "       run 'h-agent --help' for usage" >&2
            exit 2
            ;;
    esac
fi

if ! command -v "$cli" >/dev/null 2>&1; then
    echo "error: '$cli' is not installed or is not on PATH" >&2
    exit 127
fi

if [ -n "${AGENT_PROVIDER_URL:-}" ]; then
    case "$cli" in
        codex|agy)
            echo "error: $cli cannot use a local inference endpoint" >&2
            echo "       AGENT_PROVIDER_URL is set to '$AGENT_PROVIDER_URL', but only claude" >&2
            echo "       supports one. Refusing rather than starting against the vendor." >&2
            echo "       Use 'h-agent claude', or unset AGENT_PROVIDER_URL to run $cli normally." >&2
            exit 3
            ;;
        claude)
            if [ -z "${AGENT_PROVIDER_MODEL:-}" ]; then
                echo "error: AGENT_PROVIDER_URL is set but AGENT_PROVIDER_MODEL is not" >&2
                echo "       Set the model id that the endpoint actually serves." >&2
                exit 3
            fi

            unset ANTHROPIC_API_KEY ANTHROPIC_MODEL ANTHROPIC_SMALL_FAST_MODEL \
                  ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN

            url="${AGENT_PROVIDER_URL%/}"
            url="${url%/v1}"
            url="${url%/}"
            export ANTHROPIC_BASE_URL="$url"
            export ANTHROPIC_AUTH_TOKEN="${AGENT_PROVIDER_TOKEN:-local-endpoint-no-token}"
            export ANTHROPIC_DEFAULT_OPUS_MODEL="$AGENT_PROVIDER_MODEL"
            export ANTHROPIC_DEFAULT_SONNET_MODEL="$AGENT_PROVIDER_MODEL"
            export ANTHROPIC_DEFAULT_HAIKU_MODEL="${AGENT_PROVIDER_SMALL_MODEL:-$AGENT_PROVIDER_MODEL}"

            echo "h-agent: claude → $ANTHROPIC_BASE_URL (model: $AGENT_PROVIDER_MODEL)" >&2
            ;;
    esac
fi

skip="${AGENT_SKIP_PERMISSIONS:-1}"
tools="${AGENT_CLAUDE_TOOLS-Bash Read Write Edit Glob Grep}"

# Command/event capture (claude and codex). On by default; AGENT_CAPTURE=0
# disables it. The capture script lives next to this launcher and logs to
# AGENT_CAPTURE_FILE. Both CLIs record session boundaries and Bash commands only
# and pass the same stdin-JSON schema, so one capture script serves both.
capture_settings=""
capture_codex_args=()
if [ "${AGENT_CAPTURE:-1}" != 0 ] && { [ "$cli" = claude ] || [ "$cli" = codex ]; }; then
    self=$0
    case "$self" in
        */*) ;;
        *) self=$(command -v -- "$self" 2>/dev/null || printf '%s' "$self") ;;
    esac
    self_dir=$(CDPATH='' cd -- "$(dirname -- "$self")" 2>/dev/null && pwd)
    capture="$self_dir/h-agent-capture"
    if [ -n "$self_dir" ] && [ -x "$capture" ]; then
        export AGENT_CAPTURE_FILE="${AGENT_CAPTURE_FILE:-$HOME/.local/state/h-agent/commands.jsonl}"
        # Propagate a caller-supplied instance name to the capture hook.
        [ -n "${AGENT_NAME:-}" ] && export AGENT_NAME
        case "$cli" in
            claude)
                capture_settings=$(build_capture_settings "$capture")
                ;;
            codex)
                # Codex 0.163.0 hooks: registered inline via -c TOML overrides
                # (no ~/.codex/config.toml write). Hook trust cannot be set via
                # -c, so it is bypassed for this invocation -- consistent with
                # h-agent already running codex in bypass mode by default. The
                # payload is JSON on stdin with the same field names claude uses.
                codex_cmd="$capture codex"
                # All three events in one -c (a single hooks TOML table) to keep
                # the injected command line short.
                capture_codex_args=(
                    --dangerously-bypass-hook-trust
                    -c "hooks={SessionStart=[{hooks=[{type=\"command\",command=\"$codex_cmd\"}]}],SessionEnd=[{hooks=[{type=\"command\",command=\"$codex_cmd\"}]}],PreToolUse=[{matcher=\"^Bash\$\",hooks=[{type=\"command\",command=\"$codex_cmd\"}]}]}"
                )
                ;;
        esac
    fi
fi

flags=()
case "$cli" in
    claude)
        [ "$skip" = "1" ] && flags+=(--dangerously-skip-permissions)
        # Shell splitting is intentional: each tool is a separate argument.
        # shellcheck disable=SC2206
        [ -n "$tools" ] && flags+=(--tools $tools)
        [ -n "$capture_settings" ] && flags+=(--settings "$capture_settings")
        # Reasoning effort: default high, per-launch override via AGENT_EFFORT
        # (a per-launch --effort beats any effortLevel in settings). Set
        # AGENT_EFFORT='' to fall back to the model/settings default.
        effort="${AGENT_EFFORT-high}"
        [ -n "$effort" ] && flags+=(--effort "$effort")
        ;;
    agy)
        [ "$skip" = "1" ] && flags+=(--dangerously-skip-permissions)
        ;;
    codex)
        [ "$skip" = "1" ] && flags+=(--dangerously-bypass-approvals-and-sandbox)
        [ "${#capture_codex_args[@]}" -gt 0 ] && flags+=("${capture_codex_args[@]}")
        ;;
esac

exec "$cli" "${flags[@]}" "$@"
